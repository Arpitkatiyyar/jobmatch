# LLM Provider Configuration ('gemini' or 'openai')
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here

# Embedding Configuration
# Gemini gemini-embedding-001: 768 dims
# OpenAI text-embedding-3-small: 1536 dims
EMBEDDING_DIM=768

# Database Configuration (PostgreSQL 16 + pgvector via sync psycopg)
DATABASE_URL=postgresql+psycopg://jobmatch_user:jobmatch_password@localhost:5432/jobmatch_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
